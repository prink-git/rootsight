# Choose "groq" for hosted inference or "lmstudio" for a local model.
MODEL_PROVIDER=groq

# Groq setup: create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

